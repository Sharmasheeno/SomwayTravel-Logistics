# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/build/*
!/build/sites-vite-plugin.ts
/.wrangler/
/.sites-runtime/
/.runtime/
/.openai/*
!/.openai/hosting.json
/outputs/
/work/

# local runtime output
*.log
*.tsbuildinfo
/playwright-report/
/test-results/
/.playwright/
/.browser-profile/
/backups/
*.bak
*.dump

# Local audit screenshots at the repo root (regenerable dev artefacts).
# Application images live in /public and stay tracked.
/*.png

# The UI handoff prototype: src/styles.css is imported by app/layout.tsx and
# must ship, but its 27MB image library is reference material only.
/somway_ui_handoff/public/
/somway_ui_handoff/node_modules/
